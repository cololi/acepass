# Secrets and local configuration.
# Real configuration stays untracked; the templates that carry *no* secret are
# tracked, because CI and the release-gate scripts must work from the commit
# alone (`infra/docker/.env.example` was previously swallowed by `.env.*`, so a
# clean checkout could not even validate the compose file — C05).
.env
.env.*
!.env.example
!**/.env.example
backend/.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
backend/var/

# Node
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/
# Bulk before/after bundle backups: the numbers live in perfprobe/*.json, the
# 900 KB copy of the old bundle does not belong in the repository.
frontend/perfprobe/dist-before/
# Build output of the KaTeX on-demand browser probe (rebuilt by math-probe.mjs).
frontend/perfprobe/dist-math-harness/

# Runtime data (never commit learner data or uploaded material)
var/
*.log

# OS
.DS_Store

# Local TLS material for the compose stack (never commit private keys)
infra/docker/certs/

# Delivery artifacts (archives are handoff material, not source)
*.zip

# Documentation assets are committed; keep the raw capture working dirs out
dsh-plugin/var/
