# 统一换行：仓库内文本一律 LF。
* text=auto eol=lf

# 二进制资源不做行尾转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

# 语言统计：文档不参与代码行数；生成物（黄金夹具、生成的 CSS/schema、锁文件）
# 不计入语言占比，避免 1.1 万行的 schema.generated.ts 把 TypeScript 撑成主语言。
docs/** linguist-documentation
*.md linguist-documentation
frontend/package-lock.json linguist-generated
backend/requirements/lock.txt linguist-generated
dsh-plugin/tests/golden/** linguist-generated
dsh-plugin/tests/fixtures/** linguist-generated
dsh-plugin/src/client/generated/** linguist-generated
dsh-plugin/src/store/*.generated.ts linguist-generated
