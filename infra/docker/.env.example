# 复制为 .env 后填写；不要把真实密钥提交到 Git。
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=acepass.example.com,localhost
# 公共方案是 HTTPS（TLS 终止在 web/nginx）：这里必须是 https://，否则生产设置直接报错。
DJANGO_CSRF_TRUSTED_ORIGINS=https://acepass.example.com
POSTGRES_DB=acepass
POSTGRES_USER=acepass
POSTGRES_PASSWORD=change-me-as-well

# 对外端口（80 只做 301 跳转，443 终止 TLS）
ACEPASS_HTTP_PORT=8080
ACEPASS_HTTPS_PORT=8443
# TLS 证书目录，需包含 tls.crt / tls.key；本机验证可先运行 scripts/gen-dev-certs.sh ./certs
ACEPASS_TLS_DIR=./certs
ACEPASS_IMAGE_TAG=p0

# 可选：TLS 契约相关覆盖项（默认值即为推荐值，通常不需要改）
# DJANGO_SECURE_SSL_REDIRECT=true            # 不要为了探针方便关掉它
# DJANGO_USE_X_FORWARDED_HOST=false          # 再前置一层改写 Host 的代理时才置 true
# DJANGO_SECURE_HSTS_SECONDS=2592000

# AI 可选：留空或设置为 none 时，除图片识别与按需讲解外的功能全部可用。
ACEPASS_AI_PROVIDER=none
ACEPASS_AI_BASE_URL=
ACEPASS_AI_API_KEY=
ACEPASS_AI_TEXT_MODEL=
ACEPASS_AI_VISION_MODEL=
