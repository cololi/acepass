# AcePass 同源反向代理：SPA 与 /api 由同一来源提供，避免跨域并让 Session/CSRF 正常工作。
#
# TLS 终止方案（唯一终止点 = 本代理，与 backend/config/settings/prod.py 的
# “Deployment contract” 一一对应）：
#   * 443 终止 TLS，证书来自挂载目录 /etc/nginx/certs（tls.crt / tls.key，见 compose 与 README）；
#   * 80 只做 301 跳转到 443，不承载任何业务流量；
#   * 代理到上游 Gunicorn 的一段是私网明文 HTTP，因此显式发送
#     X-Forwarded-Proto: https，Django 侧由 SECURE_PROXY_SSL_HEADER 信任该头，
#     不会二次跳转，也不会把明文请求当安全请求；
#   * API 容器内的健康探针走明文 HTTP + 回环 Host，Django 侧对 /health/* 豁免
#     HTTPS 跳转（SECURE_REDIRECT_EXEMPT）；这里保持同样的路径可经代理访问，
#     便于从宿主机验证整条链路。
# 未在真实目标机器上验证：上线前请确认证书来源、上传大小限制与超时时间与实际使用相符
# （大题可能同时上传多张图片）。
upstream acepass_api {
    server api:8000;
    keepalive 16;
}

# 上游看到的协议由本机是否终止 TLS 决定：443 为 https，其余为 http。
map $https $forwarded_proto {
    "on"    https;
    default http;
}

# 明文入口的 301 必须落到实际公开的 HTTPS 端口。
#
# Compose 把宿主 ${ACEPASS_HTTP_PORT:-8080} 映射到容器 80、${ACEPASS_HTTPS_PORT:-8443}
# 映射到容器 443，所以容器里的 443 并不是公网端口：直接 `return 301 https://$host`
# 会丢掉 :8443，把用户送到一个没有监听的地址。这里只改写带端口的 Host
# （`host:port` → `host:${ACEPASS_HTTPS_PORT}`）；没有端口的 Host 保持不变，真实
# 443 部署因此不受影响。
#
# `${ACEPASS_HTTPS_PORT}` 由 nginx 镜像的 envsubst 入口脚本替换（compose 的 web
# 服务把该变量传进容器）；nginx 自己的变量（$http_host、$request_uri 等）不在环境
# 变量列表里，原样保留。
map $http_host $acepass_https_authority {
    default                                   $http_host;
    "~^(?<acepass_public_host>[^:]+):[0-9]+$" "$acepass_public_host:${ACEPASS_HTTPS_PORT}";
}

server {
    listen 80;
    server_name _;

    server_tokens off;
    client_max_body_size 32m;

    # ACME HTTP-01 挑战（可选）：证书轮换时把挑战文件写入该目录。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # 其余明文请求一律升级到 HTTPS（公共方案始终是 HTTPS），并带上真实公开端口。
    location / {
        return 301 https://$acepass_https_authority$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    server_tokens off;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 32m;

    # 安全响应头；HSTS max-age 与 Django 的 SECURE_HSTS_SECONDS 默认值（30 天）一致。
    # 代理响应里 Django 也会带同名头，这里统一 hide 掉，保证每个响应只有一份（值相同）。
    add_header Strict-Transport-Security "max-age=2592000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location /api/ {
        proxy_pass http://acepass_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;   # 附件下载走流式，不落磁盘缓冲
    }

    # 健康探针：Django 侧对这两个路径豁免 HTTPS 跳转，明文与 TLS 两种方式都可探。
    # Host 必须显式转发 $host，否则上游会收到 acepass_api 而被 ALLOWED_HOSTS 拒绝。
    location /health/ {
        proxy_pass http://acepass_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 10s;
    }

    location /static/ {
        alias /usr/share/nginx/html/;
        access_log off;
        expires 7d;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
